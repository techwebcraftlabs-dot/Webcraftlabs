# Server-side only. Never prefix secrets with VITE_ because Vite exposes those
# variables to browser code.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=true

CREDENTIAL_ENCRYPTION_KEY=

# Set true only when Hostinger/reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
